NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
GOOGLE_MAPS_API_KEY=your-server-google-maps-key
GOOGLE_MAPS_REQUESTS_PER_MINUTE=250
# Online pilot is independent of the runtime v2. Enable only after the audited
# schema, coordinated migration rollout and private LOGIN are ready.
RIDE_PILOT_ENABLED=false
RIDE_TRACKING_ENABLED=false
# Maximum straight-line distance to the best enabled dropoff when searching.
# This does not restrict the passenger's choice among a trip's enabled stops.
PILOT_MATCHING_MAX_DISTANCE_METERS=3000
PILOT_DATABASE_URL=
PILOT_DATABASE_CA=
PILOT_PUSH_ENABLED=false
PILOT_PUSH_ENCRYPTION_KEY=
PILOT_ACCOUNT_CLOSURE_ENABLED=false
PILOT_PRIVACY_URL=
PILOT_SUPPORT_URL=
# Runtime v2 is opt-in. Existing rides and v1 remain enabled when false.
RIDE_RUNTIME_ENABLED=false
RIDE_RUNTIME_PROCESS=api
RUNTIME_DATABASE_URL=
RUNTIME_DATABASE_CA=
RUNTIME_REDIS_URL=
RUNTIME_KAFKA_BROKERS=
RUNTIME_KAFKA_USERNAME=
RUNTIME_KAFKA_PASSWORD=
RUNTIME_TOPIC_PREFIX=krow
MAPBOX_ACCESS_TOKEN=
MAPBOX_REQUESTS_PER_MINUTE=250
RUNTIME_TOKEN_ENCRYPTION_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.krownmobileapp
APNS_SANDBOX=false
PAGERDUTY_PRIMARY_KEY=
PAGERDUTY_BACKUP_KEY=
PAGERDUTY_SUPERVISOR_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SAFETY_BACKUP_PHONE=
SAFETY_SUPERVISOR_PHONE=
