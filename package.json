{
  "name": "krow-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para la API y la plataforma web de KROW",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @krow/api",
    "build:web": "npm run build --workspace @krow/web",
    "dev:api": "npm run start:dev --workspace @krow/api",
    "dev:web": "npm run dev --workspace @krow/web",
    "start:api": "npm run start:prod --workspace @krow/api",
    "start:web": "npm run start --workspace @krow/web -- -p 3001",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @krow/api",
    "test:e2e": "npm run test:e2e --workspace @krow/api",
    "test:stops-import": "node --test scripts/transport-stops-csv.test.mjs",
    "stops:import": "node scripts/import-transport-stops.mjs",
    "format": "npm run format --workspaces --if-present"
  },
  "devDependencies": {
    "supabase": "2.117.0"
  }
}
